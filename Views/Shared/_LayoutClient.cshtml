<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PickMe — @ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: #f7f5f2;
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 240px;
            background: #fff;
            border-right: 1px solid #ece9e4;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            z-index: 100;
            transition: transform .3s;
        }

        .sidebar-logo {
            padding: 20px 24px;
            border-bottom: 1px solid #ece9e4;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-icon {
            width: 36px;
            height: 36px;
            background: #ff6a00;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .logo-icon svg {
                width: 20px;
                height: 20px;
                fill: #fff;
            }

        .logo-name {
            font-family: 'Nunito', sans-serif;
            font-size: 17px;
            font-weight: 800;
            color: #1a1a1a;
        }

            .logo-name span {
                color: #ff6a00;
            }

        .nav-menu {
            flex: 1;
            padding: 16px 12px;
            display: flex;
            flex-direction: column;
            gap: 4px;
            overflow-y: auto;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 14px;
            border-radius: 10px;
            color: #888;
            font-size: 14px;
            font-weight: 500;
            text-decoration: none;
            transition: all .15s;
            cursor: pointer;
            border: none;
            background: none;
            width: 100%;
            text-align: left;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

            .nav-item:hover {
                background: #fff3ed;
                color: #ff6a00;
            }

            .nav-item.active {
                background: #fff3ed;
                color: #ff6a00;
                font-weight: 600;
            }

            .nav-item svg {
                width: 18px;
                height: 18px;
                flex-shrink: 0;
            }

        .nav-section-title {
            font-size: 10px;
            color: #ccc;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .8px;
            padding: 12px 14px 4px;
        }

        .sidebar-bottom {
            padding: 16px 12px;
            border-top: 1px solid #ece9e4;
        }

        .user-card {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 10px;
            background: #f7f5f2;
        }

        .user-avatar {
            width: 34px;
            height: 34px;
            background: #ff6a00;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 700;
            color: #fff;
            flex-shrink: 0;
        }

        .user-name {
            font-size: 13px;
            font-weight: 600;
            color: #1a1a1a;
        }

        .user-role {
            font-size: 11px;
            color: #aaa;
        }

        .main-content {
            margin-left: 240px;
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .topbar {
            display: none;
            background: #fff;
            border-bottom: 1px solid #ece9e4;
            padding: 14px 20px;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 99;
        }

        .hamburger {
            cursor: pointer;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

            .hamburger span {
                width: 22px;
                height: 2px;
                background: #1a1a1a;
                border-radius: 2px;
            }

        .page-content {
            padding: 32px;
            flex: 1;
        }

        .overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.3);
            z-index: 99;
        }

        @@media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .main-content {
                margin-left: 0;
            }

            .topbar {
                display: flex;
            }

            .page-content {
                padding: 20px 16px;
            }

            .overlay.show {
                display: block;
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div class="overlay" id="overlay" onclick="closeSidebar()"></div>

    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">

        <div class="sidebar-logo">
            <div class="logo-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" />
                </svg>
            </div>
            <span class="logo-name">Pick<span>Me</span></span>
        </div>

        <nav class="nav-menu">

            <span class="nav-section-title">Principal</span>

            <a class="nav-item @(ViewData["Page"]?.ToString() == "dashboard" ? "active" : "")"
               href="/Client/Index">
                <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" />
                </svg>
                Tableau de bord
            </a>

            <a class="nav-item @(ViewData["Page"]?.ToString() == "commande" ? "active" : "")"
               href="/Client/NouvelleCommande">
                <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14l-5-5 1.41-1.41L12 14.17l7.59-7.59L21 8l-9 9z" />
                </svg>
                Nouvelle commande
            </a>

            <span class="nav-section-title">Historique</span>

            <a class="nav-item @(ViewData["Page"]?.ToString() == "historique" ? "active" : "")"
               href="/Client/Historique">
                <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42A8.954 8.954 0 0 0 13 21a9 9 0 0 0 0-18zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z" />
                </svg>
                Mes commandes
            </a>

            <a class="nav-item @(ViewData["Page"]?.ToString() == "suivi" ? "active" : "")"
               href="/Client/SuiviActif">
                <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" />
                </svg>
                Suivi en direct
            </a>

            <span class="nav-section-title">Compte</span>

            <a class="nav-item @(ViewData["Page"]?.ToString() == "profil" ? "active" : "")"
               href="/Client/Profil">
                <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                </svg>
                Mon profil
            </a>

            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z" />
                    </svg>
                    Déconnexion
                </button>
            </form>

        </nav>

        <div class="sidebar-bottom">
            <div class="user-card">
                <div class="user-avatar">
                    @(ViewData["UserName"]?.ToString()?.Substring(0, 1).ToUpper() ?? "C")
                </div>
                <div>
                    <div class="user-name">@ViewData["UserName"]</div>
                    <div class="user-role">Client</div>
                </div>
            </div>
        </div>

    </aside>
    <!-- FIN SIDEBAR -->
    <!-- CONTENU PRINCIPAL -->
    <div class="main-content">

        <!-- TOPBAR MOBILE -->
        <div class="topbar">
            <div class="hamburger" onclick="openSidebar()">
                <span></span>
                <span></span>
                <span></span>
            </div>
            <span class="logo-name" style="font-family:'Nunito',sans-serif;font-size:16px;font-weight:800;color:#1a1a1a;">
                Pick<span style="color:#ff6a00;">Me</span>
            </span>
            <div style="width:30px;"></div>
        </div>

        <!-- PAGE -->
        <div class="page-content">
            @RenderBody()
        </div>

    </div>
    <!-- FIN CONTENU PRINCIPAL -->

    <script>
        function openSidebar() {
            document.getElementById('sidebar').classList.add('open');
            document.getElementById('overlay').classList.add('show');
        }
        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('overlay').classList.remove('show');
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>