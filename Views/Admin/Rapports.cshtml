@model List<DeliveryWeb.Models.Commande>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Rapports";
    ViewData["Page"] = "rapports";

    var totalMois = (int)(ViewData["TotalMois"] ?? 0);
    var revenusMois = (decimal)(ViewData["RevenusMois"] ?? 0m);
    var totalAnnee = (int)(ViewData["TotalAnnee"] ?? 0);
    var revenusAnnee = (decimal)(ViewData["RevenusAnnee"] ?? 0m);
    var commandesAnnulees = (int)(ViewData["CommandesAnnulees"] ?? 0);
    var commandesLivrees = (int)(ViewData["CommandesLivrees"] ?? 0);
}

@section Styles {
    <style>
        .page-header {
            margin-bottom: 28px;
        }

            .page-header h1 {
                font-family: 'Nunito',sans-serif;
                font-size: 24px;
                font-weight: 800;
                color: #1a1a1a;
            }

            .page-header p {
                font-size: 14px;
                color: #aaa;
                margin-top: 4px;
            }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 16px;
            margin-bottom: 28px;
        }

        .stat-card {
            background: #fff;
            border: 1px solid #ece9e4;
            border-radius: 14px;
            padding: 20px;
        }

            .stat-card.orange {
                border-top: 4px solid #ff6a00;
            }

        .stat-label {
            font-size: 12px;
            color: #aaa;
            font-weight: 500;
            margin-bottom: 8px;
        }

        .stat-value {
            font-family: 'Nunito',sans-serif;
            font-size: 26px;
            font-weight: 900;
            color: #1a1a1a;
        }

        .stat-card.orange .stat-value {
            color: #ff6a00;
        }

        .stat-sub {
            font-size: 11px;
            color: #aaa;
            margin-top: 4px;
        }

        .section-title {
            font-family: 'Nunito',sans-serif;
            font-size: 16px;
            font-weight: 800;
            color: #1a1a1a;
            margin-bottom: 14px;
            margin-top: 28px;
        }

        .table-card {
            background: #fff;
            border: 1px solid #ece9e4;
            border-radius: 14px;
            overflow-x: auto;
            margin-bottom: 24px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 500px;
        }

        thead {
            background: #f7f5f2;
        }

        th {
            padding: 12px 16px;
            text-align: left;
            font-size: 11px;
            color: #aaa;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        td {
            padding: 13px 16px;
            font-size: 13px;
            color: #555;
            border-top: 1px solid #f0ede8;
        }

        tr:hover td {
            background: #fafaf9;
        }

        .badge {
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        .statut-Livree {
            background: #e8f5e9;
            color: #16a34a;
        }

        .statut-Annulee {
            background: #fef2f2;
            color: #ef4444;
        }

        .statut-EnAttente {
            background: #fff8e1;
            color: #f59e0b;
        }

        .statut-EnCours {
            background: #fff3ed;
            color: #ff6a00;
        }

        .statut-Acceptee {
            background: #e8f5e9;
            color: #22c55e;
        }

        .prix {
            font-family: 'Nunito',sans-serif;
            font-weight: 800;
            color: #ff6a00;
        }

        .livreur-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 16px;
            background: #fff;
            border: 1px solid #ece9e4;
            border-radius: 11px;
            margin-bottom: 8px;
        }

        .livreur-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .livreur-avatar {
            width: 34px;
            height: 34px;
            background: #ff6a00;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 800;
            color: #fff;
            flex-shrink: 0;
        }

        .livreur-name {
            font-size: 13px;
            font-weight: 700;
            color: #1a1a1a;
        }

        .livreur-meta {
            font-size: 11px;
            color: #aaa;
        }

        .livreur-revenus {
            font-family: 'Nunito',sans-serif;
            font-size: 15px;
            font-weight: 900;
            color: #ff6a00;
        }

        @@media (max-width:900px) {
            .stats-grid {
                grid-template-columns: repeat(2,1fr);
            }
        }

        @@media (max-width:500px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="page-header">
    <h1>Rapports 📊</h1>
    <p>Analyse des performances de la plateforme</p>
</div>

<!-- STATS -->
<div class="stats-grid">
    <div class="stat-card orange">
        <div class="stat-label">Commandes ce mois</div>
        <div class="stat-value">@totalMois</div>
        <div class="stat-sub">@DateTime.Now.ToString("MMMM yyyy", new System.Globalization.CultureInfo("fr-FR"))</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Revenus ce mois</div>
        <div class="stat-value" style="font-size:20px;">@revenusMois.ToString("N0")</div>
        <div class="stat-sub">FCFA — livraisons effectuées</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Commandes cette année</div>
        <div class="stat-value">@totalAnnee</div>
        <div class="stat-sub">@DateTime.Now.Year</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Revenus cette année</div>
        <div class="stat-value" style="font-size:20px;">@revenusAnnee.ToString("N0")</div>
        <div class="stat-sub">FCFA total</div>
    </div>
</div>

<!-- RÉSUMÉ -->
<div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:24px;">
    <div style="background:#e8f5e9;border:1px solid #bbf7d0;border-radius:12px;padding:16px 20px;">
        <div style="font-size:12px;color:#16a34a;font-weight:600;">✅ Livrées avec succès</div>
        <div style="font-family:'Nunito',sans-serif;font-size:28px;font-weight:900;color:#16a34a;">@commandesLivrees</div>
    </div>
    <div style="background:#fef2f2;border:1px solid #fca5a5;border-radius:12px;padding:16px 20px;">
        <div style="font-size:12px;color:#ef4444;font-weight:600;">❌ Annulées</div>
        <div style="font-family:'Nunito',sans-serif;font-size:28px;font-weight:900;color:#ef4444;">@commandesAnnulees</div>
    </div>
</div>

<!-- PERFORMANCE PAR LIVREUR -->
@{
    var statsLivreurs = ViewData["StatsLivreurs"] as dynamic;
}
<div class="section-title">🚴 Performance par livreur</div>
@if (statsLivreurs != null)
{
    foreach (var stat in statsLivreurs)
    {
        string nom = stat.Nom;
        int nbLivr = stat.NbLivr;
        decimal revenu = stat.Revenus;
        string init = nom.Length >= 2 ? nom.Substring(0, 2).ToUpper() : "??";

        <div class="livreur-row">
            <div class="livreur-info">
                <div class="livreur-avatar">@init</div>
                <div>
                    <div class="livreur-name">@nom</div>
                    <div class="livreur-meta">@nbLivr livraison(s) effectuée(s)</div>
                </div>
            </div>
            <div class="livreur-revenus">@revenu.ToString("N0") FCFA</div>
        </div>
    }
}
else
{
    <div style="text-align:center;padding:24px;color:#ccc;font-size:13px;">Aucune donnée disponible</div>
}

<!-- TOUTES LES COMMANDES DU MOIS -->
<div class="section-title">📋 Commandes du mois en cours</div>
<div class="table-card">
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Client</th>
                <th>Livreur</th>
                <th>Véhicule</th>
                <th>Type</th>
                <th>Prix</th>
                <th>Statut</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            @{
                var firstDay = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
                var commandesMois = Model.Where(c => c.DateHeure >= firstDay).ToList();
            }
            @if (!commandesMois.Any())
            {
                <tr><td colspan="8" style="text-align:center;color:#ccc;padding:32px;">Aucune commande ce mois</td></tr>
            }
            else
            {
                @foreach (var cmd in commandesMois)
                {
                    <tr>
                        <td style="font-weight:700;color:#1a1a1a;">#@cmd.Id</td>
                        <td>@cmd.NomExpediteur</td>
                        <td>@(cmd.Livreur != null ? $"{cmd.Livreur.Prenom} {cmd.Livreur.Nom}" : "—")</td>
                        <td>@cmd.TypeVehicule</td>
                        <td>@(cmd.EstExpress ? "🚀 Express" : "Standard")</td>
                        <td class="prix">@cmd.PrixCalcule.ToString("N0")</td>
                        <td><span class="badge statut-@cmd.Statut.ToString()">@cmd.Statut</span></td>
                        <td>@cmd.DateHeure.ToString("dd/MM HH:mm")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>