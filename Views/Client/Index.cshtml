@{
    Layout = "~/Views/Shared/_LayoutClient.cshtml";
    var commandes = ViewData["Commandes"] as List<DeliveryWeb.Models.Commande> ?? new();
}

@section Styles {
    <style>
        .page-header {
            margin-bottom: 28px;
        }

            .page-header h1 {
                font-family: 'Nunito', sans-serif;
                font-size: 26px;
                font-weight: 800;
                color: #1a1a1a;
            }

            .page-header p {
                font-size: 14px;
                color: #aaa;
                margin-top: 4px;
            }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-bottom: 28px;
        }

        .stat-card {
            background: #fff;
            border: 1px solid #ece9e4;
            border-radius: 14px;
            padding: 20px 22px;
        }

        .stat-label {
            font-size: 12px;
            color: #aaa;
            font-weight: 500;
            margin-bottom: 8px;
        }

        .stat-value {
            font-family: 'Nunito', sans-serif;
            font-size: 32px;
            font-weight: 800;
            color: #1a1a1a;
        }

        .stat-card.orange {
            border-left: 4px solid #ff6a00;
        }

            .stat-card.orange .stat-value {
                color: #ff6a00;
            }

        .btn-nouvelle {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #ff6a00;
            color: #fff;
            padding: 12px 22px;
            border-radius: 11px;
            font-size: 14px;
            font-weight: 700;
            font-family: 'Nunito', sans-serif;
            text-decoration: none;
            margin-bottom: 24px;
        }

            .btn-nouvelle:hover {
                background: #e55f00;
            }

        .section-title {
            font-family: 'Nunito', sans-serif;
            font-size: 16px;
            font-weight: 800;
            color: #1a1a1a;
            margin-bottom: 14px;
        }

        .commandes-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .commande-card {
            background: #fff;
            border: 1px solid #ece9e4;
            border-radius: 13px;
            padding: 16px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .commande-info {
            flex: 1;
        }

        .commande-adresse {
            font-size: 14px;
            font-weight: 600;
            color: #1a1a1a;
            margin-bottom: 4px;
        }

        .commande-meta {
            font-size: 12px;
            color: #aaa;
        }

        .commande-prix {
            font-family: 'Nunito', sans-serif;
            font-size: 15px;
            font-weight: 800;
            color: #ff6a00;
            white-space: nowrap;
        }

        .badge-statut {
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        .statut-EnAttente {
            background: #fff8e1;
            color: #f59e0b;
        }

        .statut-Acceptee {
            background: #e8f5e9;
            color: #22c55e;
        }

        .statut-EnCours {
            background: #fff3ed;
            color: #ff6a00;
        }

        .statut-Livree {
            background: #e8f5e9;
            color: #16a34a;
        }

        .statut-Annulee {
            background: #fef2f2;
            color: #ef4444;
        }

        .empty-state {
            text-align: center;
            padding: 48px 20px;
            color: #ccc;
        }

            .empty-state svg {
                width: 48px;
                height: 48px;
                fill: #ddd;
                margin-bottom: 12px;
            }

            .empty-state p {
                font-size: 15px;
            }

        .success-toast {
            background: #e8f5e9;
            border: 1px solid #bbf7d0;
            border-radius: 10px;
            padding: 12px 16px;
            color: #16a34a;
            font-size: 14px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        @@media (max-width: 768px) {
            .stats-grid {
                grid-template-columns: 1fr 1fr;
            }

                .stats-grid .stat-card:last-child {
                    grid-column: span 2;
                }
        }

        @@media (max-width: 480px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }

                .stats-grid .stat-card:last-child {
                    grid-column: span 1;
                }
        }
    </style>
}

@if (TempData["Success"] != null)
{
    <div class="success-toast">✅ @TempData["Success"]</div>
}

<div class="page-header">
    <h1>Bonjour, @ViewData["UserName"] 👋</h1>
    <p>Voici un aperçu de vos livraisons</p>
</div>

<!-- STATS -->
<div class="stats-grid">
    <div class="stat-card orange">
        <div class="stat-label">En cours</div>
        <div class="stat-value">@ViewData["EnCours"]</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Livrées</div>
        <div class="stat-value">@ViewData["Livrees"]</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">En attente</div>
        <div class="stat-value">@ViewData["EnAttente"]</div>
    </div>
</div>

<!-- BOUTON NOUVELLE COMMANDE -->
<a href="/Client/NouvelleCommande" class="btn-nouvelle">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" /></svg>
    Nouvelle commande
</a>

<!-- COMMANDES RÉCENTES -->
<div class="section-title">Commandes récentes</div>
<div class="commandes-list">
    @if (!commandes.Any())
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24"><path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4z" /></svg>
            <p>Aucune commande pour le moment</p>
        </div>
    }
    else
    {
        @foreach (var cmd in commandes.Take(5))
        {
            <div class="commande-card">
                <div class="commande-info">
                    <div class="commande-adresse">📍 @cmd.AdresseArrivee</div>
                    <div class="commande-meta">
                        @cmd.DateHeure.ToString("dd/MM/yyyy à HH:mm")
                        @if (cmd.Livreur != null)
                        {
                            <span> · @cmd.Livreur.Prenom @cmd.Livreur.Nom</span>
                        }
                    </div>
                </div>
                <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px;">
                    <span class="badge-statut statut-@cmd.Statut.ToString()">@cmd.Statut</span>
                    <span class="commande-prix">@cmd.PrixCalcule.ToString("N0") FCFA</span>
                </div>
            </div>
        }
    }
</div>