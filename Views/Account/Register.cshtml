@model DeliveryWeb.ViewModels.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Inscription";
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PickMe — Inscription</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans',sans-serif;
            background: #f7f5f2;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar {
            background: #fff;
            border-bottom: 1px solid #ece9e4;
            padding: 14px 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .logo-icon {
            width: 36px;
            height: 36px;
            background: #ff6a00;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .logo-icon svg {
                width: 20px;
                height: 20px;
                fill: #fff;
            }

        .logo-name {
            font-family: 'Nunito',sans-serif;
            font-size: 18px;
            font-weight: 900;
            color: #1a1a1a;
        }

            .logo-name span {
                color: #ff6a00;
            }

        .nav-link {
            font-size: 14px;
            color: #888;
            text-decoration: none;
            font-weight: 500;
            padding: 8px 18px;
            border: 1.5px solid #ece9e4;
            border-radius: 9px;
        }

        .main {
            flex: 1;
            display: flex;
            align-items: stretch;
        }

        .hero {
            flex: 1;
            padding: 60px 48px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #fff3ed;
            border: 1px solid #ffd4b8;
            border-radius: 20px;
            padding: 6px 14px;
            font-size: 12px;
            color: #ff6a00;
            font-weight: 600;
            margin-bottom: 24px;
            width: fit-content;
        }

        .eyebrow-dot {
            width: 7px;
            height: 7px;
            background: #ff6a00;
            border-radius: 50%;
        }

        h1 {
            font-family: 'Nunito',sans-serif;
            font-size: 38px;
            font-weight: 900;
            color: #1a1a1a;
            line-height: 1.15;
            letter-spacing: -.5px;
            margin-bottom: 16px;
        }

            h1 em {
                color: #ff6a00;
                font-style: normal;
            }

        .subtitle {
            font-size: 15px;
            color: #888;
            line-height: 1.7;
            margin-bottom: 28px;
            max-width: 380px;
        }

        .badges {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .badge {
            display: flex;
            align-items: center;
            gap: 6px;
            background: #fff;
            border: 1px solid #ece9e4;
            border-radius: 20px;
            padding: 6px 14px;
            font-size: 12px;
            color: #555;
            font-weight: 500;
        }

        .form-side {
            background: #fff;
            width: 440px;
            border-left: 1px solid #ece9e4;
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .form-title {
            font-family: 'Nunito',sans-serif;
            font-size: 22px;
            font-weight: 900;
            color: #1a1a1a;
            margin-bottom: 6px;
        }

        .form-subtitle {
            font-size: 13px;
            color: #aaa;
            margin-bottom: 24px;
        }

        .tabs {
            display: flex;
            background: #f7f5f2;
            border-radius: 11px;
            padding: 4px;
            gap: 4px;
            margin-bottom: 24px;
        }

        .tab {
            flex: 1;
            text-align: center;
            padding: 10px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            color: #aaa;
            text-decoration: none;
            display: block;
        }

            .tab.active {
                background: #fff;
                color: #ff6a00;
                box-shadow: 0 1px 6px rgba(0,0,0,.08);
            }

        .row2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .field {
            margin-bottom: 14px;
        }

            .field label {
                display: block;
                font-size: 11px;
                color: #aaa;
                font-weight: 600;
                margin-bottom: 5px;
                text-transform: uppercase;
                letter-spacing: .5px;
            }

            .field input {
                width: 100%;
                background: #fafaf9;
                border: 1.5px solid #ece9e4;
                border-radius: 10px;
                padding: 12px 14px;
                color: #1a1a1a;
                font-size: 14px;
                font-family: 'Plus Jakarta Sans',sans-serif;
                transition: border .15s;
            }

                .field input:focus {
                    outline: none;
                    border-color: #ff6a00;
                    background: #fff;
                }

                .field input::placeholder {
                    color: #ccc;
                }

        .error-msg {
            font-size: 11px;
            color: #e74c3c;
            margin-top: 4px;
            display: block;
        }

        .btn-main {
            width: 100%;
            background: #ff6a00;
            border: none;
            border-radius: 11px;
            padding: 14px;
            color: #fff;
            font-size: 15px;
            font-weight: 800;
            font-family: 'Nunito',sans-serif;
            cursor: pointer;
            transition: background .15s;
        }

            .btn-main:hover {
                background: #e55f00;
            }

        .error-box {
            background: #fff5f5;
            border: 1px solid #fcc;
            border-radius: 10px;
            padding: 12px 14px;
            color: #c0392b;
            font-size: 13px;
            margin-bottom: 18px;
        }

        .small-note {
            font-size: 11px;
            color: #ccc;
            text-align: center;
            margin-top: 14px;
            line-height: 1.6;
        }

            .small-note a {
                color: #ff6a00;
                text-decoration: none;
            }

        @@media (max-width:768px) {
            .navbar {
                padding: 12px 20px;
            }

            .main {
                flex-direction: column;
            }

            .hero {
                padding: 32px 24px 20px;
            }

            h1 {
                font-size: 26px;
            }

            .form-side {
                width: 100%;
                border-left: none;
                border-top: 1px solid #ece9e4;
                padding: 28px 24px;
            }

            .row2 {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <a class="logo" href="/">
            <div class="logo-icon">
                <svg viewBox="0 0 24 24"><path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" /></svg>
            </div>
            <span class="logo-name">Pick<span>Me</span></span>
        </a>
        <a class="nav-link" href="/Account/Login">Se connecter</a>
    </nav>

    <div class="main">
        <div class="hero">
            <div class="eyebrow"><span class="eyebrow-dot" style="width:7px;height:7px;background:#ff6a00;border-radius:50%;"></span> Inscription gratuite</div>
            <h1>Rejoignez<br><em>PickMe</em> aujourd'hui</h1>
            <p class="subtitle">Créez votre compte en moins d'une minute et passez votre première commande.</p>
            <div class="badges">
                <div class="badge">✅ Compte gratuit</div>
                <div class="badge">🔔 Alertes en temps réel</div>
                <div class="badge">📦 Livraison rapide</div>
            </div>
        </div>

        <div class="form-side">
            <div class="form-title">Créer un compte 🚀</div>
            <div class="form-subtitle">Quelques secondes suffisent</div>

            <div class="tabs">
                <a class="tab" href="/Account/Login">Connexion</a>
                <a class="tab active" href="/Account/Register">Inscription</a>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="error-box">@Html.ValidationSummary(true)</div>
            }

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()

                <div class="row2">
                    <div class="field">
                        <label>Nom</label>
                        <input asp-for="Nom" placeholder="Koné" />
                        <span asp-validation-for="Nom" class="error-msg"></span>
                    </div>
                    <div class="field">
                        <label>Prénom</label>
                        <input asp-for="Prenom" placeholder="Amara" />
                        <span asp-validation-for="Prenom" class="error-msg"></span>
                    </div>
                </div>

                <div class="field">
                    <label>Numéro de téléphone</label>
                    <input asp-for="Telephone" type="tel" placeholder="+225 07 00 00 00 00" />
                    <span asp-validation-for="Telephone" class="error-msg"></span>
                </div>

                <div class="field">
                    <label>Adresse email</label>
                    <input asp-for="Email" type="email" placeholder="vous@email.com" />
                    <span asp-validation-for="Email" class="error-msg"></span>
                </div>

                <div class="field">
                    <label>Mot de passe</label>
                    <input asp-for="MotDePasse" type="password" placeholder="Minimum 8 caractères" />
                    <span asp-validation-for="MotDePasse" class="error-msg"></span>
                </div>

                <div class="field">
                    <label>Confirmer le mot de passe</label>
                    <input asp-for="Confirmation" type="password" placeholder="Répéter le mot de passe" />
                    <span asp-validation-for="Confirmation" class="error-msg"></span>
                </div>

                <button type="submit" class="btn-main">Créer mon compte →</button>
            </form>

            <p class="small-note">
                En vous inscrivant, vous acceptez nos <a href="#">CGU</a> et notre <a href="#">Politique de confidentialité</a>
            </p>
        </div>
    </div>
</body>
</html>