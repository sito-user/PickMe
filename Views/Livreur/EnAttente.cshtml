@{
    Layout = null;
    ViewData["Title"] = "Candidature envoyée";
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PickMe — En attente</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: #f7f5f2;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .card {
            background: #fff;
            border: 1px solid #ece9e4;
            border-radius: 20px;
            padding: 48px 40px;
            max-width: 460px;
            width: 100%;
            text-align: center;
        }

        .icon {
            font-size: 56px;
            margin-bottom: 20px;
        }

        h1 {
            font-family: 'Nunito', sans-serif;
            font-size: 24px;
            font-weight: 800;
            color: #1a1a1a;
            margin-bottom: 12px;
        }

        p {
            font-size: 14px;
            color: #888;
            line-height: 1.7;
            margin-bottom: 8px;
        }

        .steps {
            background: #f7f5f2;
            border-radius: 12px;
            padding: 20px;
            margin: 24px 0;
            text-align: left;
        }

        .step {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
        }

            .step:last-child {
                margin-bottom: 0;
            }

        .step-num {
            width: 28px;
            height: 28px;
            background: #ff6a00;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 12px;
            font-weight: 700;
            flex-shrink: 0;
        }

        .step-text {
            font-size: 13px;
            color: #555;
        }

            .step-text strong {
                color: #1a1a1a;
            }

        .btn {
            display: inline-block;
            background: #ff6a00;
            color: #fff;
            padding: 12px 28px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 700;
            font-family: 'Nunito', sans-serif;
            text-decoration: none;
            margin-top: 8px;
        }

            .btn:hover {
                background: #e55f00;
            }

        .btn-outline {
            display: inline-block;
            border: 1.5px solid #ece9e4;
            color: #888;
            padding: 12px 28px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
            text-decoration: none;
            margin-top: 8px;
            margin-left: 10px;
        }
    </style>
</head>
<body>
    <div class="card">
        <div class="icon">⏳</div>
        <h1>Candidature envoyée !</h1>
        <p>Merci pour votre inscription. Notre équipe va examiner votre profil et vous notifier dès que votre compte sera approuvé.</p>

        <div class="steps">
            <div class="step">
                <div class="step-num">1</div>
                <div class="step-text"><strong>Candidature reçue</strong> — Votre dossier est en cours d'examen</div>
            </div>
            <div class="step">
                <div class="step-num" style="background:#ece9e4;color:#aaa;">2</div>
                <div class="step-text" style="color:#bbb;">Vérification du permis et des informations</div>
            </div>
            <div class="step">
                <div class="step-num" style="background:#ece9e4;color:#aaa;">3</div>
                <div class="step-text" style="color:#bbb;">Accès au tableau de bord sous 24h</div>
            </div>
        </div>

        <p style="font-size:13px;color:#aaa;">Vous recevrez un SMS dès que votre compte sera activé.</p>

        <div style="margin-top:24px;">
            <a href="/Account/Login" class="btn">Se connecter</a>
            <a href="/" class="btn-outline">Accueil</a>
        </div>
    </div>
</body>
</html>